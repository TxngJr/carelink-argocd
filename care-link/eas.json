{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://carelink.denmannsolutions.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://carelink.denmannsolutions.com"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
