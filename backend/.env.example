# Copy this file to .env (dev) or .env.production (prod) and fill in real values.
# Never commit the filled-in file.

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017
DB_NAME=carelink

# Must be a long random value in production — config.Load() refuses to
# start with the dev default when APP_ENV=production.
JWT_SECRET=change_me_to_a_long_random_value

APP_ENV=development
PORT=8080

# Required in production: comma-separated list of exact origins allowed to
# call the API / open the WebSocket, e.g. https://carelink.example.hospital
CORS_ALLOWED_ORIGINS=

# Optional: if set, /api/public/tv requires ?key=<this value>
TV_ACCESS_KEY=

# Only used by docker-compose.prod.yml, to set up the mongo container's
# root user.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
